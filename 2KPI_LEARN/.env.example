# Copie ce fichier en .env et renseigne les valeurs (ne jamais committer le vrai .env)
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-moi-avec-une-longue-chaine-aleatoire
DEBUG=False
ALLOWED_HOSTS=learn.2kpinnov.org
CSRF_TRUSTED_ORIGINS=https://learn.2kpinnov.org
# SECURE_SSL_REDIRECT=False   # uniquement le temps d'activer le certificat SSL

# Base de données PostgreSQL (vide = repli SQLite, déconseillé en production)
DB_ENGINE=postgresql
DB_NAME=c2864961c_learn
DB_USER=c2864961c_learn
DB_PASSWORD=mot-de-passe-bdd
DB_HOST=localhost
DB_PORT=5432

# E-mail sortant (SMTP cPanel) : hôte = serveur d'envoi, PAS une adresse e-mail.
# 465 = SSL (recommandé sur cPanel) ; 587 = STARTTLS. Vide = e-mails affichés dans la console.
EMAIL_HOST=mail.2kpinnov.org
EMAIL_PORT=465
EMAIL_HOST_USER=no-reply@2kpinnov.org
EMAIL_HOST_PASSWORD=mot-de-passe-de-la-boite
DEFAULT_FROM_EMAIL=2KPI Learn <no-reply@2kpinnov.org>
# Destinataires du détail des erreurs serveur (format : Nom <adresse>, séparés par des virgules)
ADMINS=Administrateur 2KPI <contacts@2kpinnov.org>

# Site vitrine autorisé à envoyer des candidatures (CORS)
VITRINE_ORIGINS=https://2kpinnov.org,https://www.2kpinnov.org
